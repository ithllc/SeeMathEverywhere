# GEMINI_API_KEY: Required for server-side Gemini multimodal scene analysis.
# AI Studio automatically injects this at runtime from user secrets.
# For Cloud Run deployment, configure as a Secret Manager secret or env var.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the multimodal Gemini model used on the server.
# Defaults to gemini-4-argon (with automatic fallback to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-argon"

# PORT: HTTP port for the Express + Vite/static server (defaults to 3000 locally, Cloud Run injects PORT=8080).
PORT="3000"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
